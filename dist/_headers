# GitHub Pages does not apply this file as HTTP response headers.
# The HTML CSP meta tag in /index.html is the enforced baseline on GitHub Pages.
# Keep these rules aligned only for static hosts that support `_headers`.

/.well-known/bimi/*
  Cross-Origin-Resource-Policy: cross-origin

/social-preview.svg
  Cross-Origin-Resource-Policy: cross-origin

/*
  Cross-Origin-Resource-Policy: same-origin
  Cross-Origin-Embedder-Policy: require-corp
  Cross-Origin-Opener-Policy: same-origin
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self'; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'; upgrade-insecure-requests
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), camera=(), microphone=()
