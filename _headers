/.well-known/*
  Access-Control-Allow-Origin: *
  Cross-Origin-Resource-Policy: cross-origin

/auth.md
  Access-Control-Allow-Origin: *
  Cross-Origin-Resource-Policy: cross-origin

/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self'; connect-src 'self'; font-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'; upgrade-insecure-requests
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), camera=(), microphone=()
