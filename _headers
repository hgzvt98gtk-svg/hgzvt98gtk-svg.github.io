/.well-known/*
  Cross-Origin-Resource-Policy: cross-origin
  Access-Control-Allow-Origin: *

/*
  Cross-Origin-Resource-Policy: same-origin
  Content-Security-Policy: default-src 'self'; script-src 'self' 'sha256-v4efwNi2tDzdqQcF++KKt7hq0GR8Fhsdhnbl3F9zDcU='; style-src 'self'; img-src 'self'; font-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'; upgrade-insecure-requests
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), camera=(), microphone=()
