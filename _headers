/.well-known/*
  Cross-Origin-Resource-Policy: cross-origin
  Access-Control-Allow-Origin: *

/auth.md
  Cross-Origin-Resource-Policy: cross-origin
  Access-Control-Allow-Origin: *

/site.js
  Content-Type: text/javascript; charset=utf-8

/*
  Cross-Origin-Resource-Policy: same-origin
  Cross-Origin-Embedder-Policy: require-corp
  Cross-Origin-Opener-Policy: same-origin
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self'; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'; upgrade-insecure-requests
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), camera=(), microphone=()
